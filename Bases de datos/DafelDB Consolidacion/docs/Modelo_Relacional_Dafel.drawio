        <mxCell id="note0" value="R27 Saldo = SUM(cantidad_variacion) por recurso, bodega y condición. Variación ≠ 0." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1458" width="2108" height="38" />
        </mxCell>
        <mxCell id="note1" value="R28 Prohibido saldo negativo. Un cambio de condición genera salida e ingreso iguales en una transacción." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1497" width="2108" height="38" />
        </mxCell>
        <mxCell id="note2" value="R29 Solo equipos; revisión de reparación registra responsable y transición real antes de habilitar." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1536" width="2108" height="38" />
        </mxCell>
        <mxCell id="note3" value="R30 UQ DetalleMovimientoInventario(id_movimiento, id_recurso, id_bodega, id_condicion)." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1575" width="2108" height="38" />
        </mxCell>
        <mxCell id="note4" value="R31 No existe saldo editable duplicado. Adquisiciones, bajas y ajustes llevan motivo y responsable." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1614" width="2108" height="38" />
