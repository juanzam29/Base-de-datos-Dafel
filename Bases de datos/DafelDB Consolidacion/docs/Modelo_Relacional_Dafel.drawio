        <mxCell id="note2" value="R06 Una versión enviada es inmutable. La tarifa cotizada es un precio histórico; no cambia con el catálogo." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
