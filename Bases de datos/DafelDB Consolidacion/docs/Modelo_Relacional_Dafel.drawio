        </mxCell>
        <mxCell id="note3" value="R07 Cada detalle cotizado pertenece a la solicitud de su cabecera. Precio ≥ 0; cantidad y tiempo cobrable &gt; 0." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
