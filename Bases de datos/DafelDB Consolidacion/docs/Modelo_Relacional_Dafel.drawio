        <mxCell id="note0" value="R54 Pagos netos = pagos válidos − reembolsos efectuados. Balance = total vigente − pagos netos." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1072" width="1607" height="38" />
        </mxCell>
        <mxCell id="note1" value="R55 Importe &gt; 0. Reembolso pendiente: sin fecha efectiva; efectuado: fecha efectiva obligatoria." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1111" width="1607" height="38" />
        </mxCell>
        <mxCell id="note2" value="R56 Reembolso no supera lo recibido neto y requiere autorización. Anticipo es un pago, no otro ingreso." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1150" width="1607" height="38" />
        </mxCell>
        <mxCell id="note3" value="R57 Cierre financiero: balance cero y sin cargos, ajustes o reembolsos por resolver." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1189" width="1607" height="38" />
        </mxCell>
        <mxCell id="note4" value="R58 Cierre operativo: entregas/servicios, retornos e incidencias resueltos; puede existir deuda." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1228" width="1607" height="38" />
        </mxCell>
