        <mxCell id="Reembolso-f11" value="N         fecha_anulacion" style="text;html=0;fontFamily=Courier New;fontSize=12;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1101" y="1498" width="348" height="25" />
        </mxCell>
        <mxCell id="Reembolso-f12" value="N         motivo_anulacion" style="text;html=0;fontFamily=Courier New;fontSize=12;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1101" y="1523" width="348" height="25" />
