  <diagram id="dafel-er-01" name="00 Guía y alcance">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1190" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="g0" value="MODELO ENTIDAD–RELACIÓN LÓGICO / DAFEL" style="text;html=0;fontSize=20;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="40" width="1810" height="35" />
        </mxCell>
        <mxCell id="gb0" value="Revision de entrega · 21 de octubre de 2026 · Modelo propuesto desde scripts; validacion en SQL Server pendiente" style="text;html=0;fontSize=15;align=left;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="78" width="1810" height="86" />
        </mxCell>
        <mxCell id="g1" value="NOTACIÓN Y LECTURA" style="text;html=0;fontSize=20;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="177" width="1810" height="35" />
        </mxCell>
        <mxCell id="gb1" value="Entidades con atributos; PK = clave primaria, FK = clave foránea, UQ = unicidad individual, N = opcional (NULL). PK compuesta: todas las filas marcadas PK forman una sola clave. Los UQ compuestos se documentan en las reglas." style="text;html=0;fontSize=15;align=left;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="215" width="1810" height="86" />
        </mxCell>
        <mxCell id="g2" value="RELACIONES" style="text;html=0;fontSize=20;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="314" width="1810" height="35" />
        </mxCell>
        <mxCell id="gb2" value="Pata de cuervo: extremo padre = 1 (o 0..1 si la FK es opcional); extremo hijo = 0..N o 0..1. Cada línea muestra el atributo FK. La obligatoriedad mínima de colecciones depende del estado: una solicitud enviada debe tener al menos una línea (ver reglas)." style="text;html=0;fontSize=15;align=left;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="352" width="1810" height="86" />
        </mxCell>
        <mxCell id="g3" value="PÁGINAS Y REFERENCIAS" style="text;html=0;fontSize=20;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="451" width="1810" height="35" />
        </mxCell>
        <mxCell id="gb3" value="01–04 Comercial, alquiler y reservas. 05–09 Operación e inventario. 10–11 Personal y control. 12–13 Dinero. 14–16 Seguimiento y evidencias. 17 Restricciones y 18 Consultas. Las tarjetas grises “REF” repiten la misma entidad para facilitar lectura, no crean tablas adicionales." style="text;html=0;fontSize=15;align=left;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="489" width="1810" height="86" />
        </mxCell>
        <mxCell id="g4" value="INTEGRIDAD" style="text;html=0;fontSize=20;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="588" width="1810" height="35" />
        </mxCell>
        <mxCell id="gb4" value="Las FK de responsables se muestran en atributos y en el registro de relaciones. Se omiten conectores repetidos para facilitar lectura. Las reglas entre registros requieren operaciones transaccionales; consultar Validacion_y_pendientes.md para saber cuales faltan." style="text;html=0;fontSize=15;align=left;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="626" width="1810" height="86" />
        </mxCell>
        <mxCell id="g5" value="SUPUESTOS PROVISIONALES / A VALIDAR CON DAFEL" style="text;html=0;fontSize=20;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="725" width="1810" height="35" />
        </mxCell>
        <mxCell id="gb5" value="100 % inicial antes del primer despacho; equipo por 24 h, mínimo 1 y fracción hacia arriba; personal por jornada; retrasos sobre cantidad pendiente, sin multa porcentual; cancelación según etapa; daño/pérdida valorado y autorizado; habilitación solo tras revisión; inventario por cantidad, sin activos individuales." style="text;html=0;fontSize=15;align=left;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="763" width="1810" height="86" />
        </mxCell>
        <mxCell id="g6" value="CONTROL DE VERSIONES" style="text;html=0;fontSize=20;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="862" width="1810" height="35" />
        </mxCell>
        <mxCell id="gb6" value="ReservaEquipo conserva identidad, línea y bodega. VersionReservaEquipo conserva snapshots aplicados e inmutables. Vigente = mayor número aplicado. CambioVersionReserva identifica la modificación aprobada. Los despachos siguen vinculados al id_reserva estable." style="text;html=0;fontSize=15;align=left;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="900" width="1810" height="86" />
        </mxCell>
        <mxCell id="g7" value="ALCANCE Y NORMALIZACIÓN" style="text;html=0;fontSize=20;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="999" width="1810" height="35" />
        </mxCell>
        <mxCell id="gb7" value="Alcance: sin compras, nomina, facturacion electronica, garantias ni rentabilidad. Modelo propuesto desde scripts: tipos, indices, auditoria y restricciones se documentan en el diccionario. Compilacion y ejecucion en SQL Server pendientes. No es un diagrama BPMN." style="text;html=0;fontSize=15;align=left;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="1037" width="1810" height="86" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
