  </diagram>
  <diagram id="dafel-er-18" name="17 Restricciones integrales">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="rt" value="DAFEL / Reglas objetivo y restricciones: implementacion parcial" style="text;fontSize=28;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="25" width="2100" height="55" />
        </mxCell>
        <mxCell id="rh0" value="UNIQUE compuestos" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="100" width="2100" height="30" />
        </mxCell>
        <mxCell id="rb0" value="Empleado(tipo_documento, numero_documento); Solicitud + linea; Cotizacion(solicitud, version); DetalleCotizacion(cotizacion, linea); Tarifa(recurso, unidad, desde); Cambio(detalle, solicitud_cambio); VersionReserva(reserva, version); Evaluacion + detalle_solicitud; DetalleMovimiento(movimiento, recurso, bodega, condicion). Ver nombres exactos en páginas de cada bloque." style="text;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="134" width="2100" height="100" />
        </mxCell>
        <mxCell id="rh1" value="VERSIONES Y CAMBIOS" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="242" width="2100" height="30" />
        </mxCell>
        <mxCell id="rb1" value="Revisión aplicada única por alquiler (solo no NULL). Snapshot de reserva aplicado e inmutable; nueva versión sustituye vigente. El cambio no modifica hechos físicos ya realizados. Si se reduce la cantidad tras devoluciones parciales, no se reabren cupos de salida; se revalida material aún fuera y se mantienen despachos históricos." style="text;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="276" width="2100" height="100" />
        </mxCell>
        <mxCell id="rh2" value="DISPONIBILIDAD" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="384" width="2100" height="30" />
        </mxCell>
        <mxCell id="rb2" value="Para cada intervalo futuro, considerar pendientes de despacho activos y unidades fuera hasta retorno previsto; marcar dependencia de retornos. Un atraso real obliga a reevaluar. Para despacho inmediato, comprobar saldo apto físico y compromisos. Reservar y validar bajo transacción con control de concurrencia." style="text;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="418" width="2100" height="100" />
        </mxCell>
        <mxCell id="rh3" value="TEMPORALIDAD" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="526" width="2100" height="30" />
        </mxCell>
        <mxCell id="rb3" value="Intervalos [inicio, fin). Igualdad de límites no implica solapamiento matemático, pero la reutilización exige retorno, inspección y preparación. Fecha fin &gt; inicio. Fechas de hechos siguen un orden coherente; no se supone que fecha de registro sea igual a fecha de ejecución." style="text;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="560" width="2100" height="100" />
        </mxCell>
        <mxCell id="rh4" value="CANTIDADES" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="668" width="2100" height="30" />
        </mxCell>
        <mxCell id="rb4" value="Solicitado/ofrecido/despachado/recibido/revisado/asignado &gt; 0; propuesta puede ser 0 para cancelar línea; disponible ≥ 0. Variación de inventario ≠ 0. Devolución acumulada ≤ despachado; inspección acumulada ≤ recibido; despacho ≤ cupo autorizado vigente." style="text;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="702" width="2100" height="100" />
        </mxCell>
        <mxCell id="rh5" value="BORRADO Y CORRECCIONES" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="810" width="2100" height="30" />
        </mxCell>
        <mxCell id="rb5" value="No eliminar maestros con historial ni operaciones ejecutadas. Maestros se desactivan; hechos físicos se corrigen con compensación y vínculo de trazabilidad a la operación original. Los estados y permisos válidos son restringidos. Una anulación económica guarda motivo, usuario y fecha." style="text;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="844" width="2100" height="100" />
        </mxCell>
        <mxCell id="rh6" value="ECONOMÍA" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="952" width="2100" height="30" />
        </mxCell>
        <mxCell id="rb6" value="Valor inicial = detalles + conceptos de la cotización aceptada. Agregar solo cargos válidos y diferencias económicas autorizadas. No calcular días de inspección como retraso del cliente. Reembolsos se descuentan solo al efectuarse. No cerrar financieramente con decisiones pendientes." style="text;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="986" width="2100" height="100" />
        </mxCell>
        <mxCell id="rh7" value="ORÍGENES Y EXCLUSIVIDAD" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1094" width="2100" height="30" />
        </mxCell>
        <mxCell id="rb7" value="Exactamente un contexto por actividad. Un origen para cada movimiento automático. Cargo/ajuste e incidencia/cambio pertenecen al mismo alquiler. Coherencia cabecera-detalle a lo largo de cotización, alquiler, despacho, devolución e inspección." style="text;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1128" width="2100" height="100" />
        </mxCell>
        <mxCell id="rh8" value="AUDITORÍA TÉCNICA" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1236" width="2100" height="30" />
        </mxCell>
        <mxCell id="rb8" value="Auditoria tecnica preparada mediante tabla y triggers DML: operacion, fecha, login original, identidad web declarada y JSON antes/despues. Hash de Usuario excluido. No registra SELECT ni intentos fallidos; ROLLBACK revierte tambien el evento. Retencion y verificacion en motor pendientes." style="text;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1270" width="2100" height="100" />
        </mxCell>
        <mxCell id="rh9" value="NORMALIZACIÓN" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1378" width="2100" height="30" />
        </mxCell>
        <mxCell id="rb9" value="PK compuestas de asociaciones se interpretan juntas; catalogos reutilizados y relaciones por ID. Evaluaciones y precios pactados representan hechos historicos. Saldos y faltantes se calculan. Esta pagina incluye reglas objetivo que aun requieren transacciones y pruebas; ver Validacion_y_pendientes.md." style="text;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1412" width="2100" height="100" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dafel-er-19" name="18 Cobertura de 12 consultas">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="qt" value="DAFEL / Trazabilidad de las doce consultas" style="text;fontSize=28;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="30" width="2100" height="55" />
        </mxCell>
        <mxCell id="qh0" value="01 Inventario" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="110" width="2100" height="30" />
        </mxCell>
        <mxCell id="qb0" value="Movimientos + detalle + recurso + bodega + condición. Reservas y fuera separados para evitar doble conteo." style="text;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="144" width="2100" height="70" />
        </mxCell>
        <mxCell id="qh1" value="02 Disponibilidad futura" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="220" width="2100" height="30" />
        </mxCell>
        <mxCell id="qb1" value="Stock apto actual y pico simultaneo de reservas pendientes de despacho; no sumar compromisos no coincidentes. Retornos previstos se muestran como dependencia, sin prometer disponibilidad antes de inspeccion." style="text;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="254" width="2100" height="70" />
        </mxCell>
        <mxCell id="qh2" value="03 Cotizaciones y conversión" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="330" width="2100" height="30" />
        </mxCell>
        <mxCell id="qb2" value="Solicitud + cotización/versiones + respuesta + alquiler. Contar solicitudes distintas para no inflar conversión por versiones." style="text;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="364" width="2100" height="70" />
        </mxCell>
        <mxCell id="qh3" value="04 Alquileres activos y vencidos" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="440" width="2100" height="30" />
        </mxCell>
        <mxCell id="qb3" value="Condiciones vigentes, cambios aceptados y aplicados, pendientes de equipo y devolucion tardia completa. Asignaciones y ejecucion de personal en resultado separado." style="text;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="474" width="2100" height="70" />
        </mxCell>
        <mxCell id="qh4" value="05 Despachos y retornos" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="550" width="2100" height="30" />
        </mxCell>
        <mxCell id="qb4" value="Solicitud → obra; alquiler → despacho → detalle → devolución. Cantidades acumuladas y constancias." style="text;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="584" width="2100" height="70" />
        </mxCell>
        <mxCell id="qh5" value="06 Utilización" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="660" width="2100" height="30" />
        </mxCell>
        <mxCell id="qb5" value="Cantidades efectivamente fuera por intervalo y capacidad alquilable histórica de equipos; bloqueos aparte. No confundir con ingresos." style="text;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="694" width="2100" height="70" />
        </mxCell>
        <mxCell id="qh6" value="07 Liquidación" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="770" width="2100" height="30" />
        </mxCell>
        <mxCell id="qb6" value="Cotización aceptada + conceptos + cargos y ajustes válidos; separar equipo/personal/transporte/retrasos/daños." style="text;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="804" width="2100" height="70" />
        </mxCell>
        <mxCell id="qh7" value="08 Pagos y reembolsos" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="880" width="2100" height="30" />
        </mxCell>
        <mxCell id="qb7" value="Pago + Reembolso + total vigente. Pendiente cobro = max(balance,0); saldo a favor = max(-balance,0)." style="text;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="914" width="2100" height="70" />
        </mxCell>
        <mxCell id="qh8" value="09 Valores y recaudos" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="990" width="2100" height="30" />
        </mxCell>
        <mxCell id="qb8" value="Agrupar valores aprobados por alquiler/cliente/obra; movimientos de dinero por fecha real. No se calcula rentabilidad." style="text;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1024" width="2100" height="70" />
        </mxCell>
        <mxCell id="qh9" value="10 Daños y pérdidas" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1100" width="2100" height="30" />
        </mxCell>
        <mxCell id="qb9" value="Incidencias + inspecciones + evidencia salida/retorno + cargos y resolución. Falta de retorno no implica pérdida automática." style="text;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1134" width="2100" height="70" />
        </mxCell>
        <mxCell id="qh10" value="11 Inspecciones y bloqueos" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1210" width="2100" height="30" />
        </mxCell>
        <mxCell id="qb10" value="Material pendiente/dañado/en reparación, movimientos de condición y revisiones con fecha y responsable." style="text;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1244" width="2100" height="70" />
        </mxCell>
        <mxCell id="qh11" value="12 Demanda no atendida" style="text;fontSize=18;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1320" width="2100" height="30" />
        </mxCell>
        <mxCell id="qb11" value="Evaluación histórica + solicitudes/rechazos/alternativas + respuesta del cliente. Evitar duplicar versiones o sumar evaluaciones como pedidos diferentes." style="text;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1354" width="2100" height="70" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dafel-er-20" name="19 Registro FK 1">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="ft" value="DAFEL / Registro completo de relaciones FK · 1/3" style="text;fontSize=26;fontStyle=1;align=left;fontColor=#155E75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="25" width="2100" height="50" />
        </mxCell>
        <mxCell id="fh" value="PADRE [clave primaria]  →  HIJO [atributo FK]       |    padre por hijo / hijos por padre" style="text;fontSize=16;fontStyle=1;align=left;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="90" width="2100" height="35" />
        </mxCell>
        <mxCell id="fk0" value="MovimientoInventario [id_movimiento] → MovimientoDespacho [id_movimiento]   |   1 / 0..1" style="text;fontSize=14;align=left;fillColor=#F1F5F9;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="140" width="2100" height="29" />
        </mxCell>
        <mxCell id="fk1" value="DetalleDespacho [id_detalle_despacho] → MovimientoDespacho [id_detalle_despacho]   |   1 / 0..1" style="text;fontSize=14;align=left;fillColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="169" width="2100" height="29" />
        </mxCell>
        <mxCell id="fk2" value="MovimientoInventario [id_movimiento] → MovimientoDevolucion [id_movimiento]   |   1 / 0..1" style="text;fontSize=14;align=left;fillColor=#F1F5F9;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="198" width="2100" height="29" />
        </mxCell>
        <mxCell id="fk3" value="DetalleDevolucion [id_detalle_devolucion] → MovimientoDevolucion [id_detalle_devolucion]   |   1 / 0..1" style="text;fontSize=14;align=left;fillColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="227" width="2100" height="29" />
        </mxCell>
        <mxCell id="fk4" value="MovimientoInventario [id_movimiento] → MovimientoInspeccion [id_movimiento]   |   1 / 0..1" style="text;fontSize=14;align=left;fillColor=#F1F5F9;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="256" width="2100" height="29" />
        </mxCell>
        <mxCell id="fk5" value="DetalleInspeccion [id_detalle_inspeccion] → MovimientoInspeccion [id_detalle_inspeccion]   |   1 / 0..1" style="text;fontSize=14;align=left;fillColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="285" width="2100" height="29" />
        </mxCell>
        <mxCell id="fk6" value="MovimientoInventario [id_movimiento] → MovimientoRevisionMaterial [id_movimiento]   |   1 / 0..1" style="text;fontSize=14;align=left;fillColor=#F1F5F9;" parent="1" vertex="1">
