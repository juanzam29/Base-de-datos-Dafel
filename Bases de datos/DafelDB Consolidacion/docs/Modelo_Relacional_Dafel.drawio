        <mxCell id="note0" value="R32 Cada movimiento automático tiene exactamente un origen entre estos cuatro enlaces." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
