        </mxCell>
        <mxCell id="note0" value="R13 UQ VersionReservaEquipo(id_reserva, numero_version). Cantidad &gt; 0; fin &gt; inicio." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1122" width="1722" height="38" />
        </mxCell>
        <mxCell id="note1" value="R14 Vigente = mayor número aplicado. Versiones inmutables; estado: activa / liberada / cumplida." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1161" width="1722" height="38" />
        </mxCell>
        <mxCell id="note2" value="R15 Reserva estable: recurso y bodega no cambian. Cambio de bodega libera lo pendiente y crea otra reserva." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1200" width="1722" height="38" />
        </mxCell>
        <mxCell id="note3" value="R16 Solo equipos. Confirmar, revalidar disponibilidad y registrar compromisos en una transacción." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1239" width="1722" height="38" />
        </mxCell>
        <mxCell id="note4" value="R17 Disponible futuro: combinar reserva pendiente + material fuera; nunca restar ambas veces lo despachado." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1278" width="1722" height="38" />
        </mxCell>
        <mxCell id="note5" value="R18 La cancelación libera salidas futuras, pero no elimina el material pendiente de retorno." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1317" width="1722" height="38" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
