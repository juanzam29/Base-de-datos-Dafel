        <mxCell id="Reembolso-f10" value="FK,N      id_usuario_anulacion" style="text;html=0;fontFamily=Courier New;fontSize=12;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1101" y="1473" width="348" height="25" />
