        <mxCell id="note0" value="R23 Recibido acumulado ≤ despachado. Cada línea recibida identifica su despacho de origen." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1308" width="1863" height="38" />
        </mxCell>
        <mxCell id="note1" value="R24 Revisado acumulado ≤ recibido. Cada cantidad sale una sola vez de pendiente de inspección." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1347" width="1863" height="38" />
        </mxCell>
        <mxCell id="note2" value="R25 Detalles de devolución e inspección deben coincidir con el alquiler y devolución de sus cabeceras." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1386" width="1863" height="38" />
        </mxCell>
        <mxCell id="note3" value="R26 Recibir y habilitar son hechos distintos. Daño recibido no es faltante ni pérdida." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1425" width="1863" height="38" />
        </mxCell>
