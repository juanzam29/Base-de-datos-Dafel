        <mxCell id="note0" value="R19 Un detalle de despacho atiende una sola reserva; dos reservas requieren dos líneas." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="972" width="1426" height="38" />
        </mxCell>
        <mxCell id="note1" value="R20 Despacho confirmado tiene detalles y autorización. Solo material apto y pago exigido satisfecho." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1011" width="1426" height="38" />
        </mxCell>
        <mxCell id="note2" value="R21 Despachado acumulado ≤ cantidad autorizada; la reserva debe pertenecer al alquiler del despacho." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1050" width="1426" height="38" />
        </mxCell>
        <mxCell id="note3" value="R22 No se crean nuevas salidas al ampliar fechas. Las devoluciones no reponen cupos para despachar otra vez." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1089" width="1426" height="38" />
        </mxCell>
