        <mxCell id="note1" value="R37 La pérdida puede no tener inspección. Un pendiente no se convierte automáticamente en pérdida." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
