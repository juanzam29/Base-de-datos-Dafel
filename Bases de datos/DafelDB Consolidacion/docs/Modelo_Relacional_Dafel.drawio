        </mxCell>
        <mxCell id="note2" value="R52 Solo registros válidos intervienen en totales. Anulación conserva motivo, fecha y usuario." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1786" width="2383" height="38" />
        </mxCell>
        <mxCell id="note3" value="R53 Total vigente = inicial aprobado + incrementos − reducciones + cargos válidos. No duplicar conceptos." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
