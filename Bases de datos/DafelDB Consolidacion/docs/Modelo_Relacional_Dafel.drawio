        <mxCell id="note0" value="R40 UQ Empleado(tipo_documento, numero_documento). Solo servicios de personal en EmpleadoServicio." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1408" width="2043" height="38" />
        </mxCell>
        <mxCell id="note1" value="R41 Sin asignaciones activas superpuestas ni coincidencias con ausencias. Empleado activo y habilitado." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1447" width="2043" height="38" />
        </mxCell>
        <mxCell id="note2" value="R42 Cobertura de personas durante todo el periodo; no basta contar asignaciones históricas." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1486" width="2043" height="38" />
        </mxCell>
        <mxCell id="note3" value="R43 No realizado: horas reales vacías y motivo obligatorio. Finalizado: inicio y fin coherentes." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1525" width="2043" height="38" />
        </mxCell>
        <mxCell id="note4" value="R44 Reemplazos conservan asignaciones anteriores. Sin nómina ni liquidaciones laborales." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1564" width="2043" height="38" />
        </mxCell>
