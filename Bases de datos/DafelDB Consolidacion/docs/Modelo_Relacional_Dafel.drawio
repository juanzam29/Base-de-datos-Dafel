        </mxCell>
        <mxCell id="note3" value="R48 Cantidad evaluada &gt; 0; disponible ≥ 0. Faltante se calcula; fechas y cantidad son instantáneas." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1525" width="2043" height="38" />
        </mxCell>
        <mxCell id="note4" value="R49 Cada revisión se agrega; el estado actual no sustituye el historial. Evaluación no reserva." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
