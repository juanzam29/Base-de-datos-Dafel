        <mxCell id="note0" value="R66 Un documento puede respaldar varias operaciones si corresponde; cada enlace evita duplicados." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1758" width="2346" height="38" />
        </mxCell>
        <mxCell id="note1" value="R67 Comprobantes respaldan pagos/reembolsos, pero no sustituyen sus registros de dinero." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
