        <mxCell id="note1" value="R46 Roles no sustituyen validaciones. Cada FK de responsable apunta al usuario o empleado indicado." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
