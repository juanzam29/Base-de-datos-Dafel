        <mxCell id="note1" value="R51 CargoIncidencia y AjusteSolicitudCambio deben vincular operaciones del mismo alquiler." style="text;html=0;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#334155;" parent="1" vertex="1">
